rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // members/{authUID}: pre-provisioned PIN identity or console-managed {username:string, playerId:string,
  // role:'owner'|'player', active:bool}. No emails, passwords or PIN hashes here.
  // public/clubhouse: member-readable official archive, draft and liveCup.
  // private/live2027: owner-only legacy match editor rounds. Same revision as clubhouse.
  // profiles/{playerId}: optional photoData JPEG <=32K chars, legend ID,
  // ordered four strengths; required updatedAt server timestamp. No identity fields.
  // liveMatches/{matchId}/scoreHistory/{changeId}: immutable hole, before/after result,
  // roster actor, generation, server timestamp, undo target and baseline coordinates.
  function roster(){return {
   'matthew.ydarraga':'player-matthew-ydarraga','michael.rodriguez':'player-michael-rodriguez',
   'jake.norris':'player-jake-norris','brandon.durman':'player-brandon-durman',
   'will.parker':'player-will-parker','ryan.higgins':'player-ryan-higgins',
   'jordan.mcneely':'player-jordan-mcneely','reid.mixon':'player-reid-mixon',
   'zach.cousar':'player-zach-cousar','jack.abraham':'player-jack-abraham',
   'peyton.braswell':'player-peyton-braswell','nate.cox':'player-nate-cox','kody.russey':'player-kody-russey'
  };}
  function active(){
   let m=get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
   return request.auth!=null && m.keys().hasAll(['username','playerId','role','active'])
    && m.active==true && m.username in roster() && m.playerId==roster()[m.username]
    && m.role in ['owner','player'] && (m.role!='owner'||m.username=='matthew.ydarraga');
  }
  function owner(){return active() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role=='owner';}
  function self(id){return active() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.playerId==id;}
  // manualStats: player-entered handicap and one editable annual best/worst record.
  function validManualRound(r){
   return r==null || (r is map && r.keys().hasAll(['score','course','location'])
    && r.keys().hasOnly(['score','course','location'])
    && r.score is int && r.score>=18 && r.score<=300
    && r.course is string && r.course.size()>0 && r.course.size()<=120
    && r.location is string && r.location.size()>0 && r.location.size()<=120);
  }
  function validManualStats(d){
   return d is map && d.keys().hasAll(['version','handicap','year','best','worst'])
    && d.keys().hasOnly(['version','handicap','year','best','worst']) && d.version==1
    && (d.handicap==null || (d.handicap is number && d.handicap>=-10 && d.handicap<=54))
    && d.year is int && d.year>=2020 && d.year<=2100
    && validManualRound(d.best) && validManualRound(d.worst)
    && (d.best==null || d.worst==null || d.best.score<=d.worst.score);
  }
  function validProfile(d){
   return d.keys().hasOnly(['photoData','fantasyCharacterId','strengthOrder','manualStats','updatedAt'])
    && (!('manualStats' in d)||validManualStats(d.manualStats))
    && d.keys().hasAll(['updatedAt']) && d.updatedAt==request.time
    && (!('photoData' in d)||(d.photoData is string && d.photoData.size()<=32000
      && d.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
    && (!('fantasyCharacterId' in d)||(d.fantasyCharacterId is string
      && d.fantasyCharacterId.matches('^legend-[a-z-]{1,50}$')))
    && (!('strengthOrder' in d)||(d.strengthOrder is list && d.strengthOrder.size()==4
      && d.strengthOrder.toSet().size()==4 && d.strengthOrder.hasOnly(['Driving','Approach','Chipping','Putting'])));
  }
  function validClubhouse(d){
   return d.keys().hasOnly(['schemaVersion','players','season2026','season2027','clubhouse','draft2027','liveCup','handicapWeight','revision','updatedAt'])
    && d.keys().hasAll(['schemaVersion','players','season2026','season2027','clubhouse','draft2027','liveCup','handicapWeight','revision','updatedAt'])
    && d.schemaVersion==4 && d.players is list && d.players.size()==13
    && d.season2026 is map && d.season2026.year==2026 && d.season2026.rounds is list
    && d.season2027 is map && d.season2027.year==2027
    && d.season2027.keys().hasOnly(['year','location','date','teams','roster','course'])
    && (!('course' in d.season2027)||verifiedCourse(d.season2027.course))
    && d.clubhouse is map && !d.clubhouse.keys().hasAny(['coverData','coverPath'])
    && d.draft2027 is map && d.draft2027.picks is list && d.draft2027.picks.size()<=12
    && d.liveCup is map && d.liveCup.year==2027 && d.liveCup.rounds is list && d.liveCup.rounds.size()<=30
    && d.handicapWeight is number && d.handicapWeight>=0 && d.handicapWeight<=100
    && d.revision is int && d.revision>0 && d.updatedAt==request.time
    && getAfter(/databases/$(database)/documents/private/live2027).data.revision==d.revision
    && getAfter(/databases/$(database)/documents/private/live2027).data.updatedAt==request.time;
  }
  function validPrivate(d){
   return d.keys().hasOnly(['year','rounds','revision','updatedAt'])
    && d.keys().hasAll(['year','rounds','revision','updatedAt']) && d.year==2027
    && d.rounds is list && d.rounds.size()<=30 && d.revision is int && d.revision>0
    && d.updatedAt==request.time
    && getAfter(/databases/$(database)/documents/public/clubhouse).data.revision==d.revision
    && getAfter(/databases/$(database)/documents/public/clubhouse).data.updatedAt==request.time;
  }
  // Auth UIDs are public identifiers, not credentials. Only these pre-created
  // PIN identities can initialize a membership; existing memberships stay intact.
  function pinIdentities(){return {
   'matthew.ydarraga':'YEcCCU6ovyd11eKrP6bM50CBmOE2',
   'michael.rodriguez':'kmi43GYZjdSAD6IdtIvrntU3lyU2',
   'jake.norris':'odxMVptzSJhpde1ffNyo4xjA15o2',
   'brandon.durman':'BhDPNH4w1lR5nwQQXNKxoHfIxBx1',
   'will.parker':'FeDQgK5NNMcKBCiCYxj8LNMkOds2',
   'ryan.higgins':'f9HCZO9x7kPClPgDkYDRUicp2mx1',
   'jordan.mcneely':'rCwG9NSeWyYFOP8ooyJBOTLZ5vi1',
   'reid.mixon':'fQhOeejdZrMuX9hiiEpXVECiVgJ2',
   'zach.cousar':'JPYKbcKTEBM0AlQMS9Op94perDS2',
   'jack.abraham':'GgfBmgOthXelPjlE73q4qye5RVU2',
   'peyton.braswell':'DLiHrLleaaeWWrKJGR6LbIT6R0t2',
   'nate.cox':'DVMgwShJuKbG4ifaFw4AWB8RDlB3',
   'kody.russey':'lwdqzuUi1dRZiwqaS5wfuRNdtrr2'
  };}
  function validPINMembership(d){
   return d.keys().hasAll(['username','playerId','role','active'])
    && d.keys().hasOnly(['username','playerId','role','active'])
    && d.username is string && d.username in roster()
    && request.auth.uid==pinIdentities()[d.username]
    && request.auth.token.email==d.username+'@gga-pin.invalid'
    && d.playerId==roster()[d.username] && d.active==true
    && d.role==(d.username=='matthew.ydarraga'?'owner':'player');
  }
  match /members/{uid} {
   allow get: if request.auth!=null && request.auth.uid==uid;
   allow create: if request.auth!=null && request.auth.uid==uid
    && validPINMembership(request.resource.data);
   allow list,update,delete: if false;
  }
  match /rosterClaims/{username} {
   allow get: if request.auth!=null;
   allow list,create,update,delete: if false;
  }
  match /public/clubhouse {
   allow read: if active();
   allow create: if owner() && validClubhouse(request.resource.data) && request.resource.data.revision==1;
   allow update: if owner() && validClubhouse(request.resource.data) && request.resource.data.revision==resource.data.revision+1;
   allow delete: if false;
  }
  match /private/live2027 {
   allow read: if owner();
   allow create: if owner() && validPrivate(request.resource.data) && request.resource.data.revision==1;
   allow update: if owner() && validPrivate(request.resource.data) && request.resource.data.revision==resource.data.revision+1;
   allow delete: if false;
  }
  // liveMatches/{id}: owner-published participant lists, round state and test flag.
  // liveScores/{matchId}_{hole}: one result per hole; no account or private data.
  function validLiveMatch(d){
   return d.keys().hasAll(['a','b','roundId','started','test','active','updatedAt'])
    && d.keys().hasOnly(['a','b','roundId','started','test','active','updatedAt'])
    && d.a is list && d.b is list && d.a.size()>=1 && d.a.size()<=4 && d.a.size()==d.b.size()
    && d.a.hasOnly(roster().values()) && d.b.hasOnly(roster().values())
    && d.a.concat(d.b).toSet().size()==d.a.size()+d.b.size()
    && d.roundId is string && d.roundId.size()>0 && d.roundId.size()<=64
    && d.started is bool && d.test is bool && d.active is bool && d.updatedAt==request.time;
  }
  function validLiveScore(id,d){
   return d.keys().hasAll(['matchId','hole','winner','updatedAt'])
    && d.keys().hasOnly(['matchId','hole','winner','updatedAt','generation','changeId'])
    && (!('generation' in d)||(d.generation is int && d.generation>=0))
    && d.matchId is string && d.matchId.size()>0 && d.matchId.size()<=64
    && d.hole is int && d.hole>=0 && d.hole<=17
    && id==d.matchId+'_'+string(d.hole)
    && d.winner in [null,'A','B','halve'] && d.updatedAt==request.time;
  }
  function scoringParticipant(d){
   let m=get(/databases/$(database)/documents/liveMatches/$(d.matchId)).data;
   let p=get(/databases/$(database)/documents/members/$(request.auth.uid)).data.playerId;
   return active() && m.active && m.started && scoreUnlocked(d) && (owner() || p in m.a || p in m.b);
  }
  function historyPath(matchId,changeId){
   return /databases/$(database)/documents/liveMatches/$(matchId)/scoreHistory/$(changeId);
  }
  function validChangeId(id){
   return id is string && id.matches('^[a-f0-9]{32}$');
  }
  function scoreHasHistory(d){
   return validChangeId(d.changeId)
    && getAfter(historyPath(d.matchId,d.changeId)).data.updatedAt==request.time
    && getAfter(historyPath(d.matchId,d.changeId)).data.hole==d.hole;
  }
  function baselineMatches(matchId,d){
   let rounds=get(/databases/$(database)/documents/public/clubhouse).data.liveCup.rounds;
   let round=rounds[d.roundIndex];
   let m=round.matches[d.matchIndex];
   return m.id==matchId && m.holes[d.hole]==d.before;
  }
  function undoMatches(matchId,d,previous){
   let target=get(historyPath(matchId,d.undoOf)).data;
   return previous.changeId==d.undoOf && target.hole==d.hole
    && target.generation==d.generation && target.undoOf==null
    && target.before==d.after && target.after==d.before
    && (owner() || self(target.actor));
  }
  function validScoreHistory(matchId,id,d){
   let fields=['hole','before','after','actor','generation','updatedAt','undoOf','roundIndex','matchIndex'];
   return validChangeId(id) && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
    && d.hole is int && d.hole>=0 && d.hole<=17
    && d.before in [null,'A','B','halve'] && d.after in [null,'A','B','halve'] && d.before!=d.after
    && self(d.actor) && d.updatedAt==request.time
    && d.generation is int && d.generation>=0
    && (d.undoOf==null || validChangeId(d.undoOf))
    && d.roundIndex is int && d.roundIndex>=0 && d.roundIndex<30
    && d.matchIndex is int && d.matchIndex>=0 && d.matchIndex<6;
  }
  function historyMatchesScore(matchId,id,d){
   let path=/databases/$(database)/documents/liveScores/$(matchId+'_'+string(d.hole));
   let after=getAfter(path).data;
   return after.changeId==id && after.updatedAt==request.time
    && after.winner==d.after && after.generation==d.generation
    && (exists(path)
     ? get(path).data.winner==d.before && (d.undoOf==null || undoMatches(matchId,d,get(path).data))
     : d.undoOf==null && baselineMatches(matchId,d));
  }
  // matchStates is separate from owner-published metadata so normal saves cannot erase locks.
  // matchAudit mirrors each state revision; append-only and required in the same transaction.
  function scoreUnlocked(d){
   let path=/databases/$(database)/documents/matchStates/$(d.matchId);
   return !exists(path) ? d.get('generation',0)==0 :
    get(path).data.status=='live' && d.get('generation',0)==get(path).data.generation;
  }
  function validCourseHole(h,n){return h.size()==4 && h.number==n && h.par in [3,4,5,6] && (h.yards==null || (h.yards is int && h.yards>0 && h.yards<=1000)) && (h.strokeIndex==null || (h.strokeIndex is int && h.strokeIndex>=1 && h.strokeIndex<=18));}
  function validCourse(c){
   return c is map && c.keys().hasAll(['source','sourceId','name','tee','rating','slope','holes','importedAt'])
    && c.keys().hasOnly(['source','sourceId','name','tee','rating','slope','holes','importedAt','correctedAt','recordId'])
    && c.source=='OpenGolfAPI' && c.sourceId is string && c.sourceId.size()<=120
    && c.name is string && c.name.size()>0 && c.name.size()<=200
    && c.tee is string && c.tee.size()<=120
    && (c.rating==null || (c.rating is number && c.rating>=20 && c.rating<=100))
    && (c.slope==null || (c.slope is number && c.slope>=55 && c.slope<=155))
    && c.holes is list && c.holes.size()==18
    && c.importedAt is string && c.importedAt.size()<=40
    && (!('correctedAt' in c)||(c.correctedAt is string && c.correctedAt.size()<=40));
  }

  // Immutable validation records keep an 18-hole import below the expression limit.
  // Each six-hole part is validated in its own request; only Matthew can publish them.
  function verifiedCourse(c){return c.recordId is string && c.recordId.size()<=64 && c==get(/databases/$(database)/documents/courseCards/$(c.recordId)).data;}
  function validCoursePart(d){return d.keys().hasOnly(['start','holes']) && d.start in [1,7,13] && d.holes is list && d.holes.size()==6 && validCourseHole(d.holes[0],d.start+0) && validCourseHole(d.holes[1],d.start+1) && validCourseHole(d.holes[2],d.start+2) && validCourseHole(d.holes[3],d.start+3) && validCourseHole(d.holes[4],d.start+4) && validCourseHole(d.holes[5],d.start+5);}
  match /courseParts/{id} {
   allow read: if active();
   allow create: if owner() && id.size()<=72 && validCoursePart(request.resource.data);
   allow update,delete: if false;
  }
  match /courseCards/{id} {
   allow read: if active();
   allow create: if owner() && id.size()>0 && id.size()<=64 && request.resource.data.recordId==id && validCourse(request.resource.data)
    && request.resource.data.holes==get(/databases/$(database)/documents/courseParts/$(id+'_1')).data.holes.concat(get(/databases/$(database)/documents/courseParts/$(id+'_7')).data.holes).concat(get(/databases/$(database)/documents/courseParts/$(id+'_13')).data.holes)
    && get(/databases/$(database)/documents/courseParts/$(id+'_1')).data.start==1
    && get(/databases/$(database)/documents/courseParts/$(id+'_7')).data.start==7
    && get(/databases/$(database)/documents/courseParts/$(id+'_13')).data.start==13;
   allow update,delete: if false;
  }
  function participant(m){
   return active() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.playerId in m.a.concat(m.b);
  }
  function validState(d,id){
   let m=get(/databases/$(database)/documents/liveMatches/$(id)).data;
   return d.keys().hasAll(['matchId','status','revision','generation','confirmed','reason','actor','updatedAt'])
    && d.keys().hasOnly(['matchId','status','revision','generation','confirmed','reason','actor','updatedAt'])
    && d.matchId==id && d.status in ['live','awaiting','final']
    && d.revision is int && d.revision>0 && d.generation is int && d.generation>=0
    && d.confirmed is list && d.confirmed.size()<=8 && d.confirmed.toSet().size()==d.confirmed.size()
    && d.confirmed.hasOnly(m.a.concat(m.b))
    && d.reason is string && d.reason.size()<=500
    && self(d.actor) && d.updatedAt==request.time && m.active && m.started;
  }
  function validTransition(old,d,id){
   let m=get(/databases/$(database)/documents/liveMatches/$(id)).data;
   return d.revision==old.revision+1 && (
    (old.status=='live' && d.status=='awaiting' && (owner()||participant(m)) && d.confirmed.size()==0 && d.generation==old.generation && d.reason=='') ||
    (old.status=='awaiting' && d.status=='awaiting' && participant(m) && !(d.actor in old.confirmed)
     && d.confirmed.size()==old.confirmed.size()+1 && d.confirmed.hasAll(old.confirmed) && d.actor in d.confirmed
     && d.generation==old.generation && d.reason=='') ||
    (old.status=='awaiting' && d.status=='final' && owner() && old.confirmed.hasAll(m.a.concat(m.b))
     && d.confirmed==old.confirmed && d.generation==old.generation && d.reason=='') ||
    (old.status in ['awaiting','final'] && d.status=='live' && owner() && d.reason.size()>0
     && d.confirmed.size()==0 && d.generation==old.generation+1));
  }
  function audited(d,id){
   let a=getAfter(/databases/$(database)/documents/matchAudit/$(id+'_'+string(d.revision))).data;
   let old=exists(/databases/$(database)/documents/matchStates/$(id))?get(/databases/$(database)/documents/matchStates/$(id)).data.status:'live';
   return a.diff(d).affectedKeys().hasOnly(['action']) && a.updatedAt==request.time
    && a.action==(d.status=='final'?'finalize':d.status=='live'?'reopen':old=='live'?'submit':'confirm');
  }
  match /matchStates/{id} {
   allow read: if active();
   allow create: if validState(request.resource.data,id)
    && validTransition({'status':'live','revision':0,'generation':0,'confirmed':[]},request.resource.data,id)
    && audited(request.resource.data,id);
   allow update: if validState(request.resource.data,id) && validTransition(resource.data,request.resource.data,id) && audited(request.resource.data,id);
   allow delete: if false;
  }
  match /matchAudit/{id} {
   allow read: if active();
   allow create: if active() && request.resource.data.keys().hasOnly(['matchId','status','revision','generation','confirmed','reason','actor','updatedAt','action'])
    && request.resource.data.action in ['submit','confirm','finalize','reopen']
    && id==request.resource.data.matchId+'_'+string(request.resource.data.revision)
    && request.resource.data.updatedAt==request.time
    && getAfter(/databases/$(database)/documents/matchStates/$(request.resource.data.matchId)).data.diff(request.resource.data).affectedKeys().hasOnly(['action'])
    && (!exists(/databases/$(database)/documents/matchStates/$(request.resource.data.matchId)) ||
     get(/databases/$(database)/documents/matchStates/$(request.resource.data.matchId)).data.revision<request.resource.data.revision);
   allow update,delete: if false;
  }
  match /liveMatches/{id} {
   allow read: if active();
   allow create,update: if owner() && id.size()>0 && id.size()<=64 && validLiveMatch(request.resource.data);
   allow delete: if false;
  }
  match /liveScores/{id} {
   allow read: if active();
   allow create: if validLiveScore(id,request.resource.data) && scoringParticipant(request.resource.data)
    && (!('changeId' in request.resource.data) || scoreHasHistory(request.resource.data));
   allow update: if validLiveScore(id,request.resource.data)
    && request.resource.data.matchId==resource.data.matchId && request.resource.data.hole==resource.data.hole
    && scoringParticipant(request.resource.data)
    && ('changeId' in request.resource.data ? scoreHasHistory(request.resource.data) : !('changeId' in resource.data));
   allow delete: if false;
  }
  match /liveMatches/{matchId}/scoreHistory/{id} {
   allow get: if active();
   allow list: if active() && request.query.limit<=50;
   allow create: if validScoreHistory(matchId,id,request.resource.data)
    && historyMatchesScore(matchId,id,request.resource.data);
   allow update,delete: if false;
  }
  match /profiles/{playerId} {
   allow read: if active();
   allow create,update: if (owner()||self(playerId)) && playerId in roster().values() && validProfile(request.resource.data);
   allow delete: if owner();
  }
  match /{document=**} {allow read,write: if false;}
 }
}
