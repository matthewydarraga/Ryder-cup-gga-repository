rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // members/{authUID}: console-only {username:string, playerId:string,
  // role:'owner'|'player', active:bool}. No emails, passwords or PIN hashes here.
  // public/clubhouse: member-readable official archive, draft and liveCup.
  // private/live2027: owner-only legacy match editor rounds. Same revision as clubhouse.
  // profiles/{playerId}: optional photoData JPEG <=32K chars, legend ID,
  // ordered four strengths; required updatedAt server timestamp. No identity fields.
  function roster(){return {
   'matthew.ydarraga':'player-matthew-ydarraga','michael.rodriguez':'player-michael-rodriguez',
   'jake.norris':'player-jake-norris','brandon.durman':'player-brandon-durman',
   'will.parker':'player-will-parker','ryan.higgins':'player-ryan-higgins',
   'jordan.mcneely':'player-jordan-mcneely','reid.mixon':'player-reid-mixon',
   'zach.cousar':'player-zach-cousar','jack.abraham':'player-jack-abraham',
   'peyton.braswell':'player-peyton-braswell','nate.cox':'player-nate-cox','kody.russey':'player-kody-russey'
  };}
  function active(){
   let m=get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
   return request.auth!=null && m.keys().hasAll(['username','playerId','role','active'])
    && m.active==true && m.username in roster() && m.playerId==roster()[m.username]
    && m.role in ['owner','player'] && (m.role!='owner'||m.username=='matthew.ydarraga');
  }
  function owner(){return active() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role=='owner';}
  function self(id){return active() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.playerId==id;}
  // manualStats: player-entered handicap and one editable annual best/worst record.
  function validManualRound(r){
   return r==null || (r is map && r.keys().hasAll(['score','course','location'])
    && r.keys().hasOnly(['score','course','location'])
    && r.score is int && r.score>=18 && r.score<=300
    && r.course is string && r.course.size()>0 && r.course.size()<=120
    && r.location is string && r.location.size()>0 && r.location.size()<=120);
  }
  function validManualStats(d){
   return d is map && d.keys().hasAll(['version','handicap','year','best','worst'])
    && d.keys().hasOnly(['version','handicap','year','best','worst']) && d.version==1
    && (d.handicap==null || (d.handicap is number && d.handicap>=-10 && d.handicap<=54))
    && d.year is int && d.year>=2020 && d.year<=2100
    && validManualRound(d.best) && validManualRound(d.worst)
    && (d.best==null || d.worst==null || d.best.score<=d.worst.score);
  }
  function validProfile(d){
   return d.keys().hasOnly(['photoData','fantasyCharacterId','strengthOrder','manualStats','updatedAt'])
    && (!('manualStats' in d)||validManualStats(d.manualStats))
    && d.keys().hasAll(['updatedAt']) && d.updatedAt==request.time
    && (!('photoData' in d)||(d.photoData is string && d.photoData.size()<=32000
      && d.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
    && (!('fantasyCharacterId' in d)||(d.fantasyCharacterId is string
      && d.fantasyCharacterId.matches('^legend-[a-z-]{1,50}$')))
    && (!('strengthOrder' in d)||(d.strengthOrder is list && d.strengthOrder.size()==4
      && d.strengthOrder.toSet().size()==4 && d.strengthOrder.hasOnly(['Driving','Approach','Chipping','Putting'])));
  }
  function validClubhouse(d){
   return d.keys().hasOnly(['schemaVersion','players','season2026','season2027','clubhouse','draft2027','liveCup','handicapWeight','revision','updatedAt'])
    && d.keys().hasAll(['schemaVersion','players','season2026','season2027','clubhouse','draft2027','liveCup','handicapWeight','revision','updatedAt'])
    && d.schemaVersion==4 && d.players is list && d.players.size()==13
    && d.season2026 is map && d.season2026.year==2026 && d.season2026.rounds is list
    && d.season2027 is map && d.season2027.year==2027
    && d.season2027.keys().hasOnly(['year','location','date','teams','roster'])
    && d.clubhouse is map && !d.clubhouse.keys().hasAny(['coverData','coverPath'])
    && d.draft2027 is map && d.draft2027.picks is list && d.draft2027.picks.size()<=12
    && d.liveCup is map && d.liveCup.year==2027 && d.liveCup.rounds is list && d.liveCup.rounds.size()<=30
    && d.handicapWeight is number && d.handicapWeight>=0 && d.handicapWeight<=100
    && d.revision is int && d.revision>0 && d.updatedAt==request.time
    && getAfter(/databases/$(database)/documents/private/live2027).data.revision==d.revision
    && getAfter(/databases/$(database)/documents/private/live2027).data.updatedAt==request.time;
  }
  function validPrivate(d){
   return d.keys().hasOnly(['year','rounds','revision','updatedAt'])
    && d.keys().hasAll(['year','rounds','revision','updatedAt']) && d.year==2027
    && d.rounds is list && d.rounds.size()<=30 && d.revision is int && d.revision>0
    && d.updatedAt==request.time
    && getAfter(/databases/$(database)/documents/public/clubhouse).data.revision==d.revision
    && getAfter(/databases/$(database)/documents/public/clubhouse).data.updatedAt==request.time;
  }
  // Self-registration is limited to unclaimed non-owner roster slots.
  // rosterClaims/{username}: immutable {uid:string, playerId:string}; no contact data.
  function validPlayerMembership(d){
   return d.keys().hasAll(['username','playerId','role','active'])
    && d.keys().hasOnly(['username','playerId','role','active'])
    && d.username is string && d.username in roster() && d.username!='matthew.ydarraga'
    && d.playerId==roster()[d.username] && d.role=='player' && d.active==true;
  }
  function validClaim(d,username){
   return d.keys().hasAll(['uid','playerId']) && d.keys().hasOnly(['uid','playerId'])
    && username in roster() && username!='matthew.ydarraga'
    && d.uid is string && d.uid==request.auth.uid && d.uid.size()<=128
    && d.playerId==roster()[username];
  }
  match /members/{uid} {
   allow get: if request.auth!=null && request.auth.uid==uid;
   allow create: if request.auth!=null && request.auth.uid==uid
    && validPlayerMembership(request.resource.data)
    && getAfter(/databases/$(database)/documents/rosterClaims/$(request.resource.data.username)).data.uid==uid
    && getAfter(/databases/$(database)/documents/rosterClaims/$(request.resource.data.username)).data.playerId==request.resource.data.playerId;
   allow list,update,delete: if false;
  }
  match /rosterClaims/{username} {
   allow get: if request.auth!=null;
   allow create: if request.auth!=null && validClaim(request.resource.data,username)
    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.username==username
    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.playerId==request.resource.data.playerId
    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.role=='player'
    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.active==true;
   allow list,update,delete: if false;
  }
  match /public/clubhouse {
   allow read: if active();
   allow create: if owner() && validClubhouse(request.resource.data) && request.resource.data.revision==1;
   allow update: if owner() && validClubhouse(request.resource.data) && request.resource.data.revision==resource.data.revision+1;
   allow delete: if false;
  }
  match /private/live2027 {
   allow read: if owner();
   allow create: if owner() && validPrivate(request.resource.data) && request.resource.data.revision==1;
   allow update: if owner() && validPrivate(request.resource.data) && request.resource.data.revision==resource.data.revision+1;
   allow delete: if false;
  }
  match /profiles/{playerId} {
   allow read: if active();
   allow create,update: if (owner()||self(playerId)) && playerId in roster().values() && validProfile(request.resource.data);
   allow delete: if owner();
  }
  match /{document=**} {allow read,write: if false;}
 }
}


